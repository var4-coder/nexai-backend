# ─────────────────────────────────────────────────────────────────────────
# NexAI Backend — variables d'environnement
# Copier ce fichier en .env et renseigner les valeurs réelles.
# Toutes les variables sont validées au démarrage (voir src/config/env.ts) :
# le process s'arrête immédiatement si une variable requise manque.
# ─────────────────────────────────────────────────────────────────────────

# ── Serveur ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# URL publique du dashboard NexAI (frontend Next.js) — utilisée pour CORS.
CLIENT_URL=http://localhost:3000

# ── Base de données & file de jobs (REQUIS) ────────────────────────────
MONGODB_URI=mongodb://localhost:27017/nexai
REDIS_URL=redis://localhost:6379

# ── Authentification (REQUIS) ───────────────────────────────────────────
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Emails transactionnels (Brevo) ─────────────────────────────────────
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@nexai.app
BREVO_SENDER_NAME=NexAI

# ── Paiements (Chariow) ─────────────────────────────────────────────────
CHARIOW_WEBHOOK_SECRET=
CHARIOW_API_KEY=

# ── Stockage médias (Cloudinary) ────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Hébergement des sites clients (Netlify) & domaines (GoDaddy) ───────
NETLIFY_ACCESS_TOKEN=
GODADDY_API_KEY=
GODADDY_API_SECRET=

# URL publique de l'API NexAI, injectée dans le HTML/JS ou les projets
# Next.js générés pour les sites clients (formulaires -> /api/v1/public).
# Exemple Render : https://nexai-api.onrender.com
PUBLIC_API_BASE_URL=http://localhost:4000

# ── IA & génération d'images ─────────────────────────────────────────────
RECRAFT_API_KEY=
ALEXYA_API_KEY=
PEXELS_API_KEY=
XAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Vidéo IA — Option 2 "Avatar" (FalAI / Kling AI Avatar v2) ──────────
FALAI_API_KEY=

# ── Vidéo IA — voix off / TTS (ElevenLabs) ─────────────────────────────
ELEVENLABS_API_KEY=
# "Rachel", voix par défaut
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ── Admin ────────────────────────────────────────────────────────────────
ADMIN_EMAIL=vermechat@gmail.com

# ── Vidéo pub — musique de fond ─────────────────────────────────────────
# Volume musique de fond (0 à 1), tier Standard.
MUSIC_VOLUME=0.8
# Volume musique de fond sous une voix off (tier "avec_son") — plus bas
# pour ne jamais couvrir la narration.
MUSIC_VOLUME_PRO=0.18
# Police pour le texte incrusté (drawtext ffmpeg). Présente par défaut sur Ubuntu.
FFMPEG_FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf
