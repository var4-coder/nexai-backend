[
  {
    "_id": "global",
    "$schema": "design-library/v3",
    "meta": {
      "version": "4.0.0",
      "baseFontPx": 16,
      "typeRatio": {
        "desktop": 1.25,
        "mobile": 1.15
      },
      "spacingUnit": 4,
      "contrastMin": 4.5,
      "touchMin": 44,
      "perf": {
        "lcpMs": 2500,
        "cls": 0.1,
        "inpMs": 200
      },
      "lineHeightMin": {
        "display_capitales_accents": 1.12,
        "display_condensee_capitales": 1.16,
        "display": 1.02,
        "body": 1.5
      }
    },
    "primitive": {
      "space": {
        "0": "0px",
        "1": "4px",
        "2": "8px",
        "3": "16px",
        "4": "24px",
        "5": "32px",
        "6": "48px",
        "7": "64px",
        "8": "96px"
      },
      "radius": {
        "none": "0px",
        "sm": "4px",
        "md": "8px",
        "lg": "12px",
        "xl": "16px",
        "full": "9999px"
      },
      "breakpoint": {
        "xs": "375px",
        "sm": "768px",
        "md": "1024px",
        "lg": "1280px",
        "xl": "1440px"
      },
      "container": {
        "sm": "720px",
        "md": "960px",
        "lg": "1120px",
        "xl": "1280px"
      },
      "z": {
        "base": 0,
        "dropdown": 20,
        "sticky": 30,
        "overlay": 40,
        "modal": 50,
        "toast": 60
      },
      "duration": {
        "instant": "100ms",
        "fast": "160ms",
        "base": "240ms",
        "slow": "360ms"
      },
      "easing": {
        "standard": "cubic-bezier(0.2, 0, 0, 1)",
        "out": "cubic-bezier(0, 0, 0.2, 1)",
        "in": "cubic-bezier(0.4, 0, 1, 1)",
        "emphasize": "cubic-bezier(0.2, 0, 0, 1.15)"
      },
      "shadow": {
        "sm": "0 1px 2px rgba(15,23,42,0.06), 0 1px 1px rgba(15,23,42,0.04)",
        "md": "0 4px 12px rgba(15,23,42,0.08), 0 1px 3px rgba(15,23,42,0.06)",
        "lg": "0 16px 40px rgba(15,23,42,0.12), 0 4px 12px rgba(15,23,42,0.06)"
      },
      "type": {
        "desktop": {
          "caption": {
            "size": "13px",
            "lh": 1.4,
            "tracking": "0.01em"
          },
          "body": {
            "size": "16px",
            "lh": 1.6,
            "tracking": "0"
          },
          "lead": {
            "size": "20px",
            "lh": 1.5,
            "tracking": "-0.01em"
          },
          "h4": {
            "size": "20px",
            "lh": 1.35,
            "tracking": "-0.015em"
          },
          "h3": {
            "size": "25px",
            "lh": 1.3,
            "tracking": "-0.02em"
          },
          "h2": {
            "size": "31px",
            "lh": 1.22,
            "tracking": "-0.025em"
          },
          "h1": {
            "size": "39px",
            "lh": 1.15,
            "tracking": "-0.03em"
          },
          "display": {
            "size": "49px",
            "lh": 1.1,
            "tracking": "-0.035em"
          },
          "hero": {
            "size": "61px",
            "lh": 1.05,
            "tracking": "-0.04em"
          }
        },
        "mobile": {
          "caption": {
            "size": "13px",
            "lh": 1.4
          },
          "body": {
            "size": "16px",
            "lh": 1.55
          },
          "lead": {
            "size": "18px",
            "lh": 1.45
          },
          "h4": {
            "size": "18px",
            "lh": 1.35
          },
          "h3": {
            "size": "21px",
            "lh": 1.3
          },
          "h2": {
            "size": "24px",
            "lh": 1.25
          },
          "h1": {
            "size": "28px",
            "lh": 1.18
          },
          "display": {
            "size": "32px",
            "lh": 1.12
          },
          "hero": {
            "size": "37px",
            "lh": 1.08
          }
        }
      }
    },
    "semantic": {
      "space": {
        "inset-xs": "{primitive.space.2}",
        "inset-sm": "{primitive.space.3}",
        "inset-md": "{primitive.space.4}",
        "inset-lg": "{primitive.space.5}",
        "stack-sm": "{primitive.space.3}",
        "stack-md": "{primitive.space.4}",
        "stack-lg": "{primitive.space.5}",
        "section-y": "{primitive.space.7}",
        "section-y-sm": "{primitive.space.6}",
        "gutter": "{primitive.space.3}",
        "gutter-lg": "{primitive.space.4}"
      },
      "type": {
        "family-body": "var(--font-body)",
        "family-display": "var(--font-display)",
        "family-mono": "ui-monospace, SFMono-Regular, Menlo, monospace",
        "weight-regular": 400,
        "weight-medium": 500,
        "weight-semibold": 600,
        "weight-bold": 700
      }
    },
    "component": {
      "button": {
        "height": "48px",
        "padding-x": "24px",
        "radius": "var(--radius-btn)",
        "font": "600 16px/1 var(--font-u)"
      },
      "input": {
        "height": "52px",
        "padding-x": "16px",
        "radius": "var(--radius)",
        "border": "1px solid var(--muted)"
      },
      "card": {
        "padding": "24px",
        "radius": "var(--radius)",
        "border": "1px solid var(--line)",
        "shadow": "selon la recette du style (ombre pleine --decor pour Wax, aucune ailleurs)"
      },
      "nav": {
        "height": "72px",
        "height-mobile": "64px"
      }
    },
    "grid": {
      "columns": 12,
      "maxWidth": "1280px",
      "padX": {
        "mobile": "16px",
        "desktop": "24px"
      }
    },
    "icon": {
      "sm": "16px",
      "md": "20px",
      "lg": "24px",
      "set": "lucide"
    },
    "media": {
      "hero": "16/9",
      "card": "4/3",
      "portrait": "3/4",
      "square": "1/1",
      "story": "9/16",
      "product": "4/5"
    },
    "css_raw": ":root{--space-0:0px;--space-1:4px;--space-2:8px;--space-3:16px;--space-4:24px;--space-5:32px;--space-6:48px;--space-7:64px;--space-8:96px;\n--duration-fast:160ms;--duration-base:240ms;--ease-standard:cubic-bezier(0.2,0,0,1);\n--text-body:clamp(16px,0.2vw + 15.4px,17px);--text-lead:clamp(18px,0.6vw + 16px,21px);--text-h3:clamp(21px,1.2vw + 17px,26px);--text-h2:clamp(28px,2.4vw + 18px,44px);\n--container:1200px;--gutter:clamp(16px,4vw,32px);--touch:44px;--measure:62ch;\n--focus-ring:0 0 0 3px color-mix(in srgb,var(--accent) 45%,transparent);}\n[data-density=\"air\"]{--section-y:clamp(88px,12vw,168px);--stack:var(--space-6)}\n[data-density=\"medium\"]{--section-y:clamp(56px,8vw,104px);--stack:var(--space-5)}\n/* Espacements de section : la recette du style prime sur --section-y. Couleurs et polices : UNIQUEMENT le bloc :root de la famille (library_familles). Titres : taille et interligne de la recette du style. */\n@media (prefers-reduced-motion:reduce){*,*::before,*::after{animation-duration:1ms!important;transition-duration:1ms!important;scroll-behavior:auto!important}}\nhtml[data-env=\"production\"] [data-origin=\"generated\"]{display:none!important}\n.prix,.nowrap{white-space:nowrap;font-variant-numeric:tabular-nums}\n[data-style=\"editorial\"]{--radius:0;--radius-btn:0}\n[data-style=\"galerie\"]{--radius:0;--radius-btn:0}\n[data-style=\"luxe\"]{--radius:0;--radius-btn:0}\n[data-style=\"affiche\"]{--radius:0;--radius-btn:0}\n[data-style=\"bento\"]{--radius:16px;--radius-btn:999px}\n[data-style=\"cinema\"]{--radius:0;--radius-btn:0}\n[data-style=\"catalogue\"]{--radius:0;--radius-btn:0}\n[data-style=\"doux\"]{--radius:20px;--radius-btn:999px}\n[data-style=\"local\"]{--radius:6px;--radius-btn:6px}\n[data-style=\"suisse\"]{--radius:0;--radius-btn:0}\n[data-style=\"wax\"]{--radius:24px;--radius-btn:999px}\n[data-style=\"plan\"]{--radius:0;--radius-btn:0}\n[data-style=\"collage\"]{--radius:2px;--radius-btn:2px}\n[data-style=\"carte\"]{--radius:0;--radius-btn:0}\n[data-style=\"partage\"]{--radius:0;--radius-btn:0}\n[data-style=\"brutal\"]{--radius:0;--radius-btn:0}\n[data-style=\"couverture\"]{--radius:0;--radius-btn:0}\n[data-style=\"tunnel\"]{--radius:14px;--radius-btn:999px}\nh1,h2{text-wrap:balance}",
    "seed_version": 7
  }
]